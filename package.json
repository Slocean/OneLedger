{
  "name": "oneledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted shared memory ledger for coding agents, exposed over MCP.",
  "bin": {
    "oneledger": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts serve",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node dist/index.js serve",
    "check": "tsc --noEmit -p tsconfig.json && vitest run",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@modelcontextprotocol/sdk": "^1.18.1",
    "hono": "^4.9.8",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
