{
  "name": "oneledger",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Self-hosted shared memory ledger for coding agents, exposed over MCP.",
  "author": "OneLedger",
  "main": "desktop/main.mjs",
  "bin": {
    "oneledger": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts serve",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "bundle:server": "node scripts/bundle-server.mjs",
    "start": "node dist/index.js serve",
    "desktop": "npm run build && electron desktop/main.mjs",
    "desktop:pack": "npm run build && node scripts/prepare-runtime.mjs && node scripts/pack-desktop.mjs",
    "tauri:build": "vite build --config web/vite.config.ts && node scripts/sync-web-embed.mjs && tauri build --bundles nsis",
    "check": "tsc --noEmit -p tsconfig.json && vitest run",
    "test": "vitest run",
    "pack": "npm run tauri:build && node scripts/stage-tauri-release.mjs",
    "release": "node scripts/trigger-release.mjs"
  },
  "build": {
    "appId": "ai.oneledger.app",
    "productName": "OneLedger",
    "asar": false,
    "directories": {
      "output": "release/desktop"
    },
    "extraMetadata": {
      "main": "main.mjs"
    },
    "files": [
      {
        "from": "desktop",
        "filter": [
          "main.mjs",
          "package.json"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app-server/dist"
      },
      {
        "from": "build-assets/prod/node_modules",
        "to": "app-server/node_modules"
      },
      {
        "from": "package.json",
        "to": "app-server/package.json"
      },
      {
        "from": "build-assets/runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "icon": "desktop/icons/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "OneLedger"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@modelcontextprotocol/sdk": "^1.18.1",
    "hono": "^4.9.8",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
