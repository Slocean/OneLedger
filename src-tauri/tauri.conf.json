{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneLedger",
  "version": "0.4.2",
  "identifier": "ai.oneledger.app",
  "build": {
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../dist/web": "web"
    },
    "windows": {
      "nsis": {
        "compression": "lzma",
        "installMode": "currentUser"
      }
    }
  }
}
