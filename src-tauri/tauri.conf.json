{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneLedger",
  "version": "0.2.0",
  "identifier": "ai.oneledger.app",
  "build": {
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../build-assets/runtime/": "runtime/",
      "../build-assets/prod/node_modules/": "app-server/node_modules/",
      "../dist/": "app-server/dist/",
      "../package.json": "app-server/package.json"
    }
  }
}
