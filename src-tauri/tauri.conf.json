{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneLedger",
  "version": "0.4.7",
  "identifier": "ai.oneledger.app",
  "build": {
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.svg",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/web": "web"
    },
    "windows": {
      "nsis": {
        "compression": "lzma",
        "installMode": "currentUser",
        "installerIcon": "icons/installer.ico",
        "uninstallerIcon": "icons/installer.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "uninstallerHeaderImage": "icons/nsis-header.bmp"
      }
    }
  }
}
